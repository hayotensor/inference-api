APP_NAME=TEE Inference API
APP_ENV=local
DEBUG=true

DATABASE_URL=postgresql+asyncpg://inference:inference@postgres:5432/inference
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=true

# Must match the main API's SECRET_PEPPER so API keys and router tokens validate.
SECRET_PEPPER=eefcc015d86d451b1662f0c655ddfef9a808323ee815be53f2f0d886bb9ac471

CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,api,inference_api,broker
REQUEST_ID_HEADER=X-Request-ID

ROUTER_RESERVATION_TTL_SECONDS=900
ROUTER_MAX_INPUT_TOKENS=1000000
ROUTER_MAX_OUTPUT_TOKENS=1000000

TOKEN_RESET_MODE=account_creation
TOKEN_RESET_DAY=1
FREE_MONTHLY_TOKEN_ALLOWANCE=0

# Optional peer mesh router endpoint. When set, /v1/inference posts to {MESH_ROUTER_URL}/inference.
MESH_ROUTER_URL=
MESH_REQUEST_TIMEOUT_SECONDS=120

# ------------------------------------------------------------------------ #
# RELAXED-REAL provisioner / attestation config.
#
# The provisioner verifies the REAL nvidia-mode attestation document (mode gate,
# nonce echo, report_data v6 recompute, TLS-SPKI pin) and seals credentials into
# the running enclave, but the two hardware-evidence gates that cannot be checked
# in this environment are turned OFF (see below). All other verification stays
# real; the real (secure) NVIDIA/Intel backends are still selected so the
# backend_insecure_gate passes — they are just never invoked.
# ------------------------------------------------------------------------ #
PROVISIONER_ENABLED=true

# Platform Ed25519 provisioning SIGNING seed (64-hex). Its verify key
# (ef2c5897...cafc) is the miner's TEE_VALIDATOR_STATIC_KEYS, so the enclave
# accepts our signed /provision payloads.
PROVISIONER_SIGNING_KEY_HEX=6a9fc949c6fb3a8fb61b29ef2b43da8c1c67ff0de765ce85b8a0b0d0ba20e818

# Dedicated Fernet key for at-rest encryption of provisioned tokens (NOT the pepper).
PROVISIONER_TOKEN_ENCRYPTION_KEY=1Js-MPgKaz7S_ReS7JZnQJLlVXqROwBEquVQTgZIB6w=

# Production verifier path (real NVIDIA/Intel backends selected), NOT the dev stub.
VERIFIER_BACKEND=auto
ALLOW_DEV_ATTESTATION=false

# RELAXED: skip the GPU-evidence (NRAS RIM) and TDX-quote gates. The evidence is
# still REAL and attached to the document; we simply do not require the verifier
# to call NVIDIA NRAS (no RIM exists for this Blackwell VBIOS -> 404) or to
# demand a TDX quote (host has no QGS). verify_attestation only runs step 4/5
# (the NRAS/TDX backend calls) when these are true, so False => skipped.
REQUIRE_GPU_EVIDENCE=false
REQUIRE_TDX_QUOTE=false

# Keep the TLS fingerprint pin ON for forwarding (works: pin is by sha256(leaf DER)).
TLS_PIN_ENFORCE=true

# After sealing creds, drive the enclave's POST /engine/start so vLLM actually
# loads the model and the proxy can serve REAL completions.
PROVISIONER_START_ENGINE=true
PROVISIONER_ENGINE_NAME=sglang
# vLLM load of Llama-3.1-8B takes 1-3 min; give the readiness wait headroom.
PROVISIONER_ENGINE_START_TIMEOUT_SECONDS=420

# Poll the provisioner loop frequently so the newly-registered miner is picked up fast.
PROVISIONER_LOOP_INTERVAL_SECONDS=15
PROVISIONER_ENGINE_ARGS={"attention_backend":"triton"}

# ------------------------------------------------------------------------ #
# HYP-61: subnet-delegate-stake -> inference-credits quota (placeholder config).
#
# Turned ON per explicit request, with PLACEHOLDER formula numbers pending real
# calibration against actual stake sizes. NOTE: ht-indexer is not currently
# running/deployed anywhere in this environment (checked: no process, no pm2
# entry), so this feature is armed but functionally inert right now -- the
# background refresh loop will just fail to reach HT_INDEXER_GRAPHQL_URL every
# SUBNET_STAKE_REFRESH_INTERVAL_SECONDS and log an error; the existing
# fail-safe (errored snapshots never revoke/grant allowance) means this is
# harmless, not silently wrong. Once ht-indexer is actually deployed, update
# HT_INDEXER_GRAPHQL_URL to its real reachable address and confirm
# SUBNET_STAKE_SUBNET_ID matches the actual registered subnet ID (1 is a
# placeholder based on this codebase's existing subnet_id=1 convention, e.g.
# inference-subnet's telemetry/local_chain_functions defaults -- verify against
# the real on-chain subnet registration before relying on this).
# ------------------------------------------------------------------------ #
SUBNET_STAKE_QUOTA_ENABLED=true
HT_INDEXER_GRAPHQL_URL=http://localhost:4350/graphql
HT_INDEXER_TIMEOUT_SECONDS=10
SUBNET_STAKE_SUBNET_ID=1
SUBNET_STAKE_DECIMALS=18
SUBNET_STAKE_MIN_DAYS=30
# Placeholder economics: 100 staked (normalized) tokens = 1 unit, 1 unit =
# 10,000 inference tokens/week, capped at 2.5M tokens/week (roughly the Pro
# plan's weekly allowance) so this can never out-earn just subscribing to a
# paid tier. Needs real calibration against actual token price/typical stake
# sizes before this is more than a placeholder.
SUBNET_STAKE_MIN_AMOUNT=100
SUBNET_STAKE_TOKENS_UNIT=100
SUBNET_STAKE_TOKENS_PER_UNIT=10000
SUBNET_STAKE_WEEKLY_TOKEN_CAP=2500000
SUBNET_STAKE_REFRESH_INTERVAL_SECONDS=900
