APP_NAME=Inference API
APP_ENV=local
DEBUG=true
API_BASE_URL=http://localhost:8000
# Public URL of the user-facing frontend (dashboard + /chat). Used for email
# links, the SIWE sign-in message, and SSO. In production this is your app host.
APP_URL=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://inference:inference@postgres:5432/inference
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_STORAGE_URL=redis://redis:6379/1
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_ENABLED=true
TOKEN_REVOCATION_FAIL_OPEN=true

JWT_SECRET=replace-with-32-byte-random-secret
JWT_AUDIENCE=fastapi-users:auth
JWT_LIFETIME_SECONDS=900
REFRESH_TOKEN_LIFETIME_DAYS=30
VERIFICATION_TOKEN_SECRET=replace-with-32-byte-random-secret
RESET_PASSWORD_TOKEN_SECRET=replace-with-32-byte-random-secret
OAUTH_STATE_SECRET=replace-with-32-byte-random-secret
SESSION_SECRET=replace-with-32-byte-random-secret
SECRET_PEPPER=replace-with-32-byte-random-secret
# SSO cookie token, verified by the talaris-edge Worker — set both to the SAME value.
SSO_SECRET=replace-with-32-byte-random-secret
SSO_AUDIENCE=talaris:sso
SSO_TTL_SECONDS=28800

# Add your app origin(s) in production, e.g. https://app.talaris.xyz
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# EMAIL_PROVIDER: console | smtp | sendgrid | resend | ses
# Production: use resend (set RESEND_API_KEY); manage DKIM/SPF/DMARC DNS in
# Cloudflare for EMAIL_FROM's domain. Cloudflare itself cannot send email.
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SENDGRID_API_KEY=
RESEND_API_KEY=
AWS_REGION=us-east-1

SMS_PROVIDER=console
DEFAULT_PHONE_REGION=US
PHONE_USER_EMAIL_DOMAIN=phone-users.example.com
# Sign-in-with-wallet (SIWE) login: synthetic-email domain for wallet-only
# accounts (must be an owned domain in production) + the EIP-4361 chain id.
WALLET_USER_EMAIL_DOMAIN=wallet-users.example.com
WALLET_SIWE_CHAIN_ID=1
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
API_KEY_DEFAULT_RATE_LIMIT_PER_MINUTE=120

# Stripe. Run `python scripts/stripe_sync_plans.py --write-env` after setting the
# secret key: it creates the products/prices/portal config and fills in the IDs below.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:8000/billing/stripe/webhook`, or from
# `stripe_sync_plans.py --webhook-url https://<api-host>/billing/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=
# Stripe redirects the browser here, so these must be UI (Next.js) URLs, not API URLs.
STRIPE_SUCCESS_URL=http://localhost:3000/billing/success
STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel
STRIPE_CUSTOMER_PORTAL_RETURN_URL=http://localhost:3000/dashboard/billing
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_STARTER_ANNUAL_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_BUSINESS_ANNUAL_PRICE_ID=

ETHEREUM_RPC_URL=
ETHEREUM_ERC20_CONTRACT_ADDRESS=
ETHEREUM_ERC20_DECIMALS=18
SUBSTRATE_EVM_RPC_URL=
SUBSTRATE_NATIVE_DECIMALS=18

# TOKEN_RESET_MODE: account_creation | calendar_month | weekly
TOKEN_RESET_MODE=account_creation
TOKEN_RESET_DAY=1
TOKEN_RESET_WEEKDAY=0  # 0=Monday; anchor for weekly mode
FREE_MONTHLY_TOKEN_ALLOWANCE=100000
WALLET_NONCE_TTL_SECONDS=600

# Subnet-stake weekly quota. The indexer read + tuning live in the inference
# service; the main API only needs the switch (for usage reporting parity).
SUBNET_STAKE_QUOTA_ENABLED=false
