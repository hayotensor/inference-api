NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_INFERENCE_API_BASE_URL=http://localhost:8001
# Server-side only (never exposed via NEXT_PUBLIC_). The platform provisioner's
# Ed25519 verify key, hex-encoded -- the SAME value you pass to every subnet
# validator as --allowlist_signer_pubkey (inference-subnet/inference/cli/run_node.py)
# and to every TEE as PROVISIONER_VERIFY_KEY_HEX
# (inference-subnet-miner/docs/deployment.md). One key, configured identically
# everywhere it's checked -- fetch it ONCE from GET /attest on the inference-api
# at setup time and copy it here; do not hardcode it in source, and do not leave
# this unset (attestation-status/route.ts fails closed with no pin configured).
PLATFORM_PUBKEY=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Publishable (pk_...) key only. Checkout/portal redirects are created by the API;
# the UI uses this to label test-mode billing.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
